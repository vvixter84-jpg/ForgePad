<Window x:Class="ForgePad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ForgePad.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ForgePad"
        Icon="/app.ico"
        Height="700" Width="1120"
        MinHeight="480" MinWidth="760"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        AllowDrop="True"
        Drop="OnFilesDropped"
        DragOver="OnDragOver">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Background="{DynamicResource PanelBrush}" MouseLeftButtonDown="OnHeaderDrag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <!-- Логотип: рамка и три полосы как осциллограмма -->
                    <Border Width="24" Height="24" CornerRadius="7"
                            Background="{DynamicResource AccentDimBrush}" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="6" Canvas.Top="9" Width="2.5" Height="6"
                                       RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource AccentBrush}" />
                            <Rectangle Canvas.Left="11" Canvas.Top="6" Width="2.5" Height="12"
                                       RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource AccentBrush}" />
                            <Rectangle Canvas.Left="16" Canvas.Top="8" Width="2.5" Height="8"
                                       RadiusX="1.2" RadiusY="1.2" Fill="{DynamicResource AccentBrush}" />
                        </Canvas>
                    </Border>
                    <TextBlock Text="FORGEPAD" Style="{StaticResource MonoText}" FontSize="13" FontWeight="Bold" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           x:Name="TitleHint"
                           Text="саундпад в микрофон"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button Content="—" Style="{StaticResource IconButton}" Click="OnMinimize" ToolTip="Свернуть" />
                    <Button Content="✕" Style="{StaticResource IconButton}" Click="OnClose" ToolTip="Закрыть" />
                </StackPanel>
            </Grid>

            <!-- Панель инструментов -->
            <Grid Grid.Row="1" Margin="16,10,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource SearchBox}"
                             TextChanged="OnSearchChanged"
                             ToolTip="Поиск по названию" />
                    <TextBlock x:Name="SearchHint"
                               Text="поиск по названию"
                               Style="{StaticResource MutedText}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                </Grid>

                <Button Grid.Column="1" Content="＋ Добавить" Style="{StaticResource FlatButton}"
                        Margin="10,0,0,0" Click="OnAddClick" ToolTip="Добавить звуки (Ctrl+O)" />

                <Button Grid.Column="2" Content="Стоп" Style="{StaticResource FlatButton}"
                        Margin="8,0,0,0" Click="OnStopClick" ToolTip="Остановить всё (F10)" />

                <Button Grid.Column="3" x:Name="MonitorButton" Content="Монитор: вкл"
                        Style="{StaticResource FlatButton}"
                        Margin="8,0,0,0" Click="OnMonitorClick" ToolTip="Слышать звуки самому (F11)" />

                <Button Grid.Column="4" x:Name="ThemeButton" Content="Тема"
                        Style="{StaticResource FlatButton}"
                        Margin="8,0,0,0" Click="OnThemeClick" ToolTip="Оформление" />
            </Grid>

            <!-- Сетка и инспектор -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="GridHost">
                    <local:PadGrid x:Name="Pads" />

                    <Canvas x:Name="Overlay">
                        <TextBox x:Name="RenameBox"
                                 Visibility="Collapsed"
                                 Style="{StaticResource SearchBox}"
                                 KeyDown="OnRenameKey"
                                 LostFocus="OnRenameLostFocus" />
                    </Canvas>
                </Grid>

                <Border Grid.Column="1"
                        Width="272"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid Margin="16,14,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="ЗВУК" Style="{StaticResource MutedText}" FontSize="10.5" />

                        <TextBlock x:Name="InspectorHint"
                                   Grid.Row="1"
                                   Text="выбери плитку, чтобы настроить название, клавишу, громкость и цвет"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Top"
                                   Margin="0,12,0,0" />

                        <StackPanel x:Name="InspectorBody" Grid.Row="1" Visibility="Collapsed">
                            <TextBlock Text="НАЗВАНИЕ" Style="{StaticResource MutedText}" Margin="0,14,0,6" />
                            <TextBox x:Name="NameBox"
                                     Style="{StaticResource SearchBox}"
                                     KeyDown="OnNameKey"
                                     LostFocus="OnNameLostFocus" />

                            <TextBlock Text="КЛАВИША" Style="{StaticResource MutedText}" Margin="0,18,0,6" />
                            <Button x:Name="HotkeyButton"
                                    Content="назначить"
                                    Style="{StaticResource FlatButton}"
                                    Click="OnHotkeyButtonClick"
                                    HorizontalContentAlignment="Center" />

                            <TextBlock Text="ГРОМКОСТЬ" Style="{StaticResource MutedText}" Margin="0,18,0,6" />
                            <Slider x:Name="GainSlider"
                                    Style="{StaticResource DarkSlider}"
                                    Minimum="0" Maximum="1.5"
                                    ValueChanged="OnGainChanged" />

                            <TextBlock Text="ЦВЕТ" Style="{StaticResource MutedText}" Margin="0,18,0,6" />
                            <WrapPanel x:Name="ColorPanel" />

                            <Button Content="Проверить звук"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,26,0,0"
                                    Click="OnCheckClick"
                                    ToolTip="Длительность, громкость и состояние файла" />

                            <Button Content="Удалить звук"
                                    Style="{StaticResource FlatButton}"
                                    Margin="0,8,0,0"
                                    Click="OnDeleteClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Статус -->
            <Border Grid.Row="3" Background="{DynamicResource PanelBrush}">
                <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="16,0,0,0" />
            </Border>
        </Grid>
    </Border>
</Window>
